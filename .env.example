# Copy to ".env" and fill in real values. Never commit ".env".

# Required for Goalserve REST feeds, WebSocket auth (live.goalserve.com), and
# optional ?key= on the inplay gzip URL when GOALSERVE_INPLAY_SOCCER_URL is unset.
GOALSERVE_API_KEY=

# Optional. If Goalserve gave you a full URL for the inplay odds feed, set it here.
# If empty, the app uses http://inplay.goalserve.com/inplay-soccer.gz (with ?key=
# when GOALSERVE_API_KEY is set).
GOALSERVE_INPLAY_SOCCER_URL=

# Optional. true = background thread polls the inplay gzip feed every second and
# writes snapshot files under data/. false = disabled (default).
INPLAY_SCHEDULER_JOB=false

# Scheduler interval for inplay polling (seconds)
INPLAY_SCHEDULER_INTERVAL_SECONDS=1

# Scheduler loop sleep/check frequency (seconds)
SCHEDULER_LOOP_SLEEP_SECONDS=1.0

# Goalserve request timeouts (seconds)
GOALSERVE_REQUEST_TIMEOUT_SECONDS=30
GOALSERVE_INPLAY_TIMEOUT_SECONDS=5
GOALSERVE_INPLAY_SCHEDULER_TIMEOUT_SECONDS=2
GOALSERVE_LIVE_TIMEOUT_SECONDS=15
GOALSERVE_WS_AUTH_TIMEOUT_SECONDS=10
